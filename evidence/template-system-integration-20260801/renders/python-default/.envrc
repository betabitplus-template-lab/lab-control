#!/usr/bin/env bash
if [ -d .venv ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi

# shellcheck disable=SC1091
source scripts/env/project_config.sh
if ! py_lib_load_project_env_config "$PWD"; then
  printf '%s\n' "Could not read [tool.ternforge] env config from pyproject.toml." >&2
fi

if [ -f scripts/env/secrets.sh ]; then
  # shellcheck source=/dev/null
  source scripts/env/secrets.sh
  py_lib_load_secrets "$PWD"
fi

export PYTHONPATH="$PWD/src:$PWD${PYTHONPATH:+:$PYTHONPATH}"
